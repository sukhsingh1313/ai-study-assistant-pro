# ==========================================
# AI Study Assistant - Environment Config
# ==========================================

APP_NAME="AI Study Assistant"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.codewithsukh.online
APP_TIMEZONE=UTC
FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_STACK_CHANNELS="single,stderr"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (Render PostgreSQL / MySQL / SQLite)
# Note: On Render, set DATABASE_URL to your PostgreSQL connection string
DB_CONNECTION=pgsql
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ai_study_assistant
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# Drivers (database / redis / file)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# Redis Configuration (Optional)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cloudinary Storage Configuration (Optional)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=
